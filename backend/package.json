{
  "name": "myra-server",
  "version": "1.0.0",
  "description": "Backend for the myra (AI personal assistant)",
  "license": "ISC",
  "author": "srinivasa",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "dev": "tsx watch index.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "migrate:chroma": "tsx scripts/migratePgvectorToChroma.ts",
    "migrate:chroma:dry-run": "tsx scripts/migratePgvectorToChroma.ts --dry-run",
    "start": "node dist/index.js",
    "start:legacy": "nodemon index.js",
    "test": "node test/test-setup.js"
  },
  "dependencies": {
    "@google-cloud/local-auth": "^3.0.1",
    "@google/generative-ai": "^0.24.1",
    "@langchain/anthropic": "^1.3.26",
    "@langchain/community": "^1.1.28",
    "@langchain/core": "^1.1.48",
    "@langchain/google-genai": "^2.1.26",
    "@langchain/langgraph": "^1.2.7",
    "@langchain/openai": "^1.4.7",
    "@langchain/textsplitters": "^1.0.1",
    "axios": "^1.16.1",
    "chromadb": "^3.5.0",
    "cors": "^2.8.5",
    "date-fns": "^4.1.0",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "googleapis": "^170.1.0",
    "jsonwebtoken": "^9.0.3",
    "langchain": "^1.2.39",
    "natural": "^8.1.0",
    "node-cron": "^4.2.1",
    "nodemailer": "^8.0.7",
    "nodemon": "^3.1.11",
    "passport": "^0.7.0",
    "pg": "^8.20.0",
    "redis": "^5.10.0",
    "socket.io": "^4.8.3",
    "stopword": "^3.1.5",
    "uuid": "^13.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.1.0",
    "@types/nodemailer": "^8.0.1",
    "@types/passport": "^1.0.17",
    "tsx": "^4.23.0",
    "typescript": "^6.0.3"
  }
}
