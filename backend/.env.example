# =============================================================================
# MyRA backend — environment template (FND-05.2)
# =============================================================================
# Getting started:
#
#     cp .env.example .env          # then fill in the (secret) blanks
#     npm run services:up           # starts postgres/chroma/redis (docker)
#     npm run migrate               # applies database migrations
#     npm run dev                   # starts the backend
#
# Defaults below match docker-compose.dev.yml at the repo root — the compose
# services listen on non-standard ports (55432/58000/56379) precisely so they
# never collide with anything you already run locally.
#
# Lines marked (secret) are intentionally blank. Never commit real values;
# .env is gitignored, this template is not. Startup validation
# (src/config/runtimeConfig.ts) reports every missing/invalid variable at once
# and never prints a secret value.

# -----------------------------------------------------------------------------
# Server
# -----------------------------------------------------------------------------
NODE_ENV=development
PORT=2020
# Comma-separated list of allowed browser origins.
CORS_ORIGIN=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# -----------------------------------------------------------------------------
# PostgreSQL (required — the one hard dependency at every stage)
# -----------------------------------------------------------------------------
# These credentials match the docker-compose.dev.yml defaults. If you point at
# any database other than the local dev container, change them together with
# the compose overrides (MYRA_V2_PG_USER / MYRA_V2_PG_PASSWORD / MYRA_V2_PG_DB)
# — and never reuse the local-only password anywhere real.
DB_HOST=localhost
DB_PORT=55432
DB_NAME=myra_v2
DB_USER=myra
DB_PASSWORD=myra_v2_local_dev
DB_SSL=false
DB_MAX_CONNECTIONS=10

# -----------------------------------------------------------------------------
# Vector store
# -----------------------------------------------------------------------------
# "chroma" (local container, the dev/test default) or "pgvector".
VECTOR_STORE=chroma
CHROMA_HOST=localhost
CHROMA_PORT=58000
CHROMA_SSL=false
CHROMA_COLLECTION=myra_chunks_v1
# Chroma Cloud only — leave blank for the local container. Setting an API key
# selects cloud mode, which then also requires tenant + database.
CHROMA_API_KEY=
CHROMA_TENANT=
CHROMA_DATABASE=
# To populate a fresh local Chroma from Postgres (no re-embedding):
#     npm run migrate:chroma

# -----------------------------------------------------------------------------
# Redis
# -----------------------------------------------------------------------------
REDIS_URL=redis://localhost:56379
# Redis is optional until TOL-03 (locks/queues); an unreachable Redis degrades
# readiness instead of failing it while this stays false.
REDIS_REQUIRED=false

# -----------------------------------------------------------------------------
# Auth (secret)
# -----------------------------------------------------------------------------
# Generate each with:  openssl rand -hex 32
JWT_SECRET=
TOKEN_ENCRYPTION_KEY=

# -----------------------------------------------------------------------------
# Runtime behaviour
# -----------------------------------------------------------------------------
# Migrations on boot: "auto" applies pending migrations, "verify" only reports
# drift. Unset = auto in development, verify everywhere else ("auto" is
# rejected outright in production). Uncomment to override:
# MIGRATIONS_ON_BOOT=verify
READINESS_PROBE_TIMEOUT_MS=2000
SHUTDOWN_DRAIN_TIMEOUT_MS=10000
# Keep crons off until Google OAuth credentials below are configured; the sync
# crons call Google APIs and will only log errors without them.
ENABLE_CRON_JOBS=false

# =============================================================================
# V1 application keys — read directly by the existing runtime, not yet
# validated by runtimeConfig. Fill in what you use; blanks fall back to
# in-code defaults where they exist.
# =============================================================================

# --- LLM providers (secret keys) ---
ANTHROPIC_API_KEY=
ANTHROPIC_CHAT_MODEL=
ANTHROPIC_MODEL_TEMP=
ANTHROPIC_MAX_TOKENS=
ANTHROPIC_MONTHLY_BUDGET=
CLAUDE_MODEL=
CLAUDE_MAX_TOKENS=
CLAUDE_TEMPERATURE=
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=
OPENAI_PLANNER_MODEL=
OPENAI_LIGHT_MODEL=
OPENAI_MODEL_TEMP=
OPENAI_MAX_TOKENS=
GEMINI_API_KEY=
GEMINI_EMBEDDING_MODEL=
GEMINI_MAX_OUTPUT_TOKENS=
GEMINI_TEMPERATURE=
GEMINI_TOP_K=
GEMINI_TOP_P=

# --- Embeddings ---
OPENAI_EMBEDDING_MODEL=
EMBEDDING_DIMENSIONS=

# --- Google OAuth (Gmail/Calendar sync) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
GOOGLE_REDIRECT_URI_PROD=
SYNC_USER_ID=

# --- Mail alerts (SMTP) ---
MAIL_SMTP_HOST=
MAIL_SMTP_PORT=
MAIL_USER=
MAIL_APP_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=
MAIL_ALERT_RECIPIENT=

# --- Cron schedules & toggles ---
CRON_TIMEZONE=
ENABLE_EMBEDDING_CRON=false
EMBEDDING_CRON_SCHEDULE=
ENABLE_GMAIL_SYNC_CRON=false
GMAIL_SYNC_CRON_SCHEDULE=
ENABLE_CREDS_ALERT_CRON=false
CREDS_ALERT_CRON_SCHEDULE=
ENABLE_API_BUDGET_ALERT_CRON=false
API_BUDGET_ALERT_CRON_SCHEDULE=

# --- Misc / legacy ---
FRONTEND_URL_PROD=
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=
